# Application
PORT=8000
WEB_SERVER_PORT=8000
BASE_URL=http://localhost:8000

# MySQL Database
MYSQL_HOST=database
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=generic-root-password
MYSQL_DATABASE=generic_database
MYSQL_USER=generic_user
MYSQL_PASSWORD=generic-password
DB_SYNCHRONIZE=false

# MongoDB GridFS
MONGODB_URI=mongodb://generic_admin:generic_password@mongodb:27017/roll_and_reserve?authSource=admin
MONGO_INITDB_ROOT_USERNAME=generic_admin
MONGO_INITDB_ROOT_PASSWORD=generic_password
MONGO_CLUSTER_URL=mongodb://mongodb

# Authentication & Security
JWT_SECRET=supersecretjwtkeyforrollandreservedatabase2026
JWT_EXPIRES_IN=30d
ENABLE_TOKEN_VALIDATION=true

# Firebase Cloud Messaging
